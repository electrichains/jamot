# Jamot environment (copy to .env and fill in)

# --- Database ---
DATABASE_URL=postgres://jamot:jamot@localhost:5433/jamot
REDIS_URL=redis://localhost:6379

# --- Auth ---
SESSION_SECRET=change-me-to-a-long-random-string
AUTH_COOKIE_NAME=jamot_session

# --- Google OAuth (sign-in with Google) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback
FRONTEND_URL=http://localhost:3000

# --- Super Admin ---
# Comma-separated emails that are granted full platform super-admin access at boot (grant-only).
SUPER_ADMIN_EMAILS=

# --- LLM providers (both behind a provider interface) ---
LLM_DEFAULT_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com

# --- Channels ---
# Matrix (self-hosted Synapse)
MATRIX_HOMESERVER_URL=http://localhost:8008
MATRIX_BOT_USER=
MATRIX_BOT_PASSWORD=
# WhatsApp (Baileys) — session dir for persistent state
WHATSAPP_SESSION_DIR=./.data/whatsapp
# Where the API proxies the WhatsApp control server (channel worker)
# Local: http://localhost:3001 — Render: http://jamot-channels:10000
WA_WORKER_URL=http://localhost:3001
# Control server port for the channel worker (default: 3001; Render uses $PORT)
WA_CONTROL_PORT=3001

# --- API ---
API_HOST=0.0.0.0
API_PORT=4000
CORS_ORIGIN=http://localhost:3000
